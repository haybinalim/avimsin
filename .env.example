# Avımsın ortam ayarları — bu dosyayı `.env` olarak kopyalayın ve doldurun.
# `.env` .gitignore'dadır; gizli anahtarlar ASLA repoya girmez.

# --- RPC uçları ---
# İstediğiniz kadar tanımlayın; `avimsin-rpc` hepsini ölçüp tablo verir.
# Format: RPC_<AD>=<json-rpc-url>

# Robinhood Chain resmî public RPC (Faz 1'de resmî dokümandan teyit edilecek)
# Değer örneği (rate limitli): https://rpc.mainnet.chain.robinhood.com
RPC_ROBINHOOD_PUBLIC=

# Herkese açık Ethereum uçları (araç denemesi için örnek)
RPC_PUBLIC_LLAMA=https://eth.llamarpc.com
RPC_PUBLIC_NODE=https://ethereum-rpc.publicnode.com

# Alchemy: https://www.alchemy.com — ücretsiz hesap açın, API key alın
# Örnek: https://eth-mainnet.g.alchemy.com/v2/<API_KEY>
RPC_ALCHEMY=

# QuickNode: https://www.quicknode.com — ücretsiz hesap açın, endpoint alın
# Örnek: https://<kendi-endpoint>.quiknode.pro/<token>/
RPC_QUICKNODE=

# --- Bildirim eşikleri (Faz 5) ---
# Bir coin'i "sinyal" saymak için gereken minimum smart wallet sayısı
SMART_WALLET_SIGNAL_THRESHOLD=3

# --- Telegram bildirimleri (Faz 5) ---
# BotFather'dan bot açıp token'ı, sohbet kimliğini buraya girin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# İzleme döngüsünün zinciri yoklama aralığı (saniye)
WATCH_POLL_SECONDS=30
