# Avımsın ortam ayarları — bu dosyayı `.env` olarak kopyalayın ve doldurun.
# `.env` .gitignore'dadır; gizli anahtarlar ASLA repoya girmez.

# --- RPC uçları ---
# İstediğiniz kadar tanımlayın; `avimsin-rpc` hepsini ölçüp tablo verir.
# Format: RPC_<AD>=<json-rpc-url>
# RPC_SOLANA* adları Solana, diğer adlar EVM olarak kontrol edilir.
# Adaptörler RPC_ROBINHOOD* / RPC_SOLANA* adlarını alfabetik sıralayıp ilkini
# seçer; genel sağlayıcı adları yalnız kontrol komutu içindir, otomatik yedek yoktur.

# Robinhood Chain resmî public RPC (Faz 1'de resmî dokümandan teyit edilecek)
# Değer örneği (rate limitli): https://rpc.mainnet.chain.robinhood.com
RPC_ROBINHOOD_PUBLIC=

# Herkese açık Ethereum uçları (araç denemesi için örnek)
RPC_PUBLIC_LLAMA=https://eth.llamarpc.com
RPC_PUBLIC_NODE=https://ethereum-rpc.publicnode.com

# Alchemy: https://www.alchemy.com — ücretsiz hesap açın, API key alın
# Örnek: https://eth-mainnet.g.alchemy.com/v2/<API_KEY>
RPC_ALCHEMY=

# QuickNode: https://www.quicknode.com — ücretsiz hesap açın, endpoint alın
# Örnek: https://<kendi-endpoint>.quiknode.pro/<token>/
RPC_QUICKNODE=

# Solana (Faz 6): varsayılan resmî public devnet ucudur; mainnet için Helius/QuickNode
# Örnek: https://mainnet.helius-rpc.com/?api-key=<API_KEY>
#RPC_SOLANA_MAINNET=

# --- Bildirim eşikleri (Faz 5) ---
# Bir coin'i "sinyal" saymak için gereken minimum smart wallet sayısı
SMART_WALLET_SIGNAL_THRESHOLD=3

# --- Telegram bildirimleri (Faz 5) ---
# BotFather'dan bot açıp token'ı, sohbet kimliğini buraya girin.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# İzleme döngüsünün zinciri yoklama aralığı (saniye)
WATCH_POLL_SECONDS=30
# Tek turda geriye dönük taranacak en fazla aralık (blok/slot). Boş = sınır yok.
# Solana gibi hızlı zincirlerde servis durup yeniden başlarsa biriken aralık
# imza sayfalamasını şişirir; örn. 20000 makul bir üst sınırdır.
WATCH_MAX_SLOTS_PER_POLL=
- SOLANA_MIN_INTERVAL_SECONDS=0.9
- SOLANA_MAX_TX_PER_WALLET=100
- DISTRIBUTION_MIN_RECEIVERS=3
# Solana izleme modu: wallet (varsayılan; cüzdan bazlı) ya da coin (eski, coin bazlı).
WATCH_SOLANA_MODE=wallet
# Cüzdan bazlı izleme: cüzdan başına tur başına açılacak en çok yeni işlem.
WATCH_MAX_TX_PER_WALLET_POLL=50
# Giriş sayılmayan mint'ler (virgülle); boş = wSOL, USDC, USDT.
WATCH_IGNORED_MINTS=
# Yüksek frekans (bot) kuralı: son WATCH_BOT_WINDOW_SECONDS içinde WATCH_BOT_MAX_INFLOWS'tan
# FAZLA farklı giriş kaydı olan cüzdan sinyal sayımına katılmaz (geçici; pencere kayınca döner).
WATCH_BOT_WINDOW_SECONDS=3600
WATCH_BOT_MAX_INFLOWS=10
