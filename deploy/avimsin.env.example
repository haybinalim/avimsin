# Avımsın VPS ortam dosyası — ÖRNEK, gerçek değerleri yazıp `.env` adıyla
# uygulama dizinine kopyalayın. Bu dosya repoda kalır, `.env` ASLA girmez.
#
#   cp deploy/avimsin.env.example /opt/avimsin/.env
#   nano /opt/avimsin/.env   # değerleri doldurun
#   chmod 600 /opt/avimsin/.env

# --- RPC uçları (en az biri zorunlu) ---
# Format: RPC_<AD>=<json-rpc-url>
RPC_ROBINHOOD_PUBLIC=https://rpc.mainnet.chain.robinhood.com
# Üretim önerisi: Alchemy/QuickNode ücretsiz uç (rate limit'e takılmamak için)
#RPC_ALCHEMY=https://eth-mainnet.g.alchemy.com/v2/<API_KEY>
#RPC_QUICKNODE=https://<kendi-endpoint>.quiknode.pro/<token>/
# Solana izlenecekse mainnet ucu (devnet varsayılanı üretimde KULLANMAYIN)
#RPC_SOLANA_MAINNET=https://mainnet.helius-rpc.com/?api-key=<API_KEY>

# --- Sinyal eşiği ---
# Bir coin'i "sinyal" saymak için gereken minimum smart wallet sayısı
SMART_WALLET_SIGNAL_THRESHOLD=3

# --- Telegram (zorunlu: bildirim bu kanaldan gider) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Zincir yoklama aralığı (saniye)
WATCH_POLL_SECONDS=30
