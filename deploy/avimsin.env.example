# Avımsın VPS ortam dosyası — ÖRNEK, gerçek değerleri yazıp `.env` adıyla
# uygulama dizinine kopyalayın. Bu dosya repoda kalır, `.env` ASLA girmez.
#
#   cp deploy/avimsin.env.example /opt/avimsin/.env
#   nano /opt/avimsin/.env   # değerleri doldurun
#   chmod 600 /opt/avimsin/.env

# --- RPC uçları (en az biri zorunlu) ---
# Format: RPC_<AD>=<json-rpc-url>
# Varsayılan zincir Solana (install.sh --chain solana): mainnet ucu (devnet varsayılanı
# üretimde KULLANMAYIN)
#RPC_SOLANA_MAINNET=https://mainnet.helius-rpc.com/?api-key=<API_KEY>
# Robinhood/EVM (Solana bitince): --chain robinhood ile kurulursa kullanılır
#RPC_ROBINHOOD_PUBLIC=https://rpc.mainnet.chain.robinhood.com
# Adaptör seçimi: zincir önekli adların alfabetik ilki; otomatik failover yoktur.
# Üretim için sağlayıcının DOĞRU AĞA ait ucunu bu önekle tanımlayın:
#RPC_ROBINHOOD_ALCHEMY=<robinhood-mainnet-json-rpc-url>
#RPC_ROBINHOOD_QUICKNODE=<robinhood-mainnet-json-rpc-url>

# --- Sinyal eşiği ---
# Bir coin'i "sinyal" saymak için gereken minimum smart wallet sayısı
SMART_WALLET_SIGNAL_THRESHOLD=3

# --- Telegram (zorunlu: bildirim bu kanaldan gider) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Zincir yoklama aralığı (saniye)
WATCH_POLL_SECONDS=30
# Tek turda geriye dönük taranacak en fazla aralık (blok/slot). Boş = sınır yok.
# Solana'da 20000 gibi bir üst sınır önerilir (servis yeniden başlarsa
# biriken slot farkı imza sayfalamasını şişirmesin).
WATCH_MAX_SLOTS_PER_POLL=
# Solana izleme modu: wallet (varsayılan; cüzdan bazlı) ya da coin (eski, coin bazlı).
WATCH_SOLANA_MODE=wallet
# Cüzdan bazlı izleme: cüzdan başına tur başına açılacak en çok yeni işlem.
WATCH_MAX_TX_PER_WALLET_POLL=50
# Giriş sayılmayan mint'ler (virgülle); boş = wSOL, USDC, USDT.
WATCH_IGNORED_MINTS=

# Sinyal penceresi (saniye): eşik, son bu kadar süredeki farklı smart wallet
# sayısıyla değerlendirilir (blok sayısına zincir aralığıyla çevrilir).
WATCH_SIGNAL_WINDOW_SECONDS=3600
# İlk tam sinyalden sonra bu süre boyunca aynı coin için yalnız YENİ cüzdan katılırsa
# "güncelleme" gider; süre dolunca coin sıfırlanır, eşik aşımı yine tam sinyaldir.
WATCH_ALERT_COOLDOWN_SECONDS=86400

# filter/score kalıcı analiz penceresi uzunluğu (saniye; varsayılan 24 saat).
# Blok/slot sayısına filters/chains.py BLOCK_INTERVAL_SECONDS ile çevrilir.
ANALYSIS_WINDOW_SECONDS=86400
